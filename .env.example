VITE_API_URL=https://your-backend-domain.com/api

# Vite dev: if VITE_API_URL is http://localhost:5000/api, the app uses same-origin /api (Vite proxy) instead.
# Set true only if you want the browser to call host :5000 directly (bypass proxy).
# VITE_DIRECT_API=false

# Desactiva AWS SDK si no lo usas
VITE_DISABLE_AWS_SDK=true
VITE_NO_AWS=true
